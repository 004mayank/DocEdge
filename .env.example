# Copy to .env and fill as needed
#   cp .env.example .env

# --- API ---
# Used to sign JWTs. Replace with a long random string.
JWT_SECRET=replace-with-long-secret

# Select providers (if the app supports switching)
AI_PROVIDER=openai
STT_PROVIDER=deepgram

# Provider keys (leave blank if you don't use these features)
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# --- Web ---
# Base URL for the API from the browser.
# For local docker-compose, the API is exposed on host port 3002.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002
